<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Career Match Challenge - Bimbingan & Konseling Fase E</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Plus Jakarta Sans & Nunito -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Tone.js untuk efek suara lembut tanpa file eksternal -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        display: ['"Nunito"', 'sans-serif'],
                    },
                    colors: {
                        cream: '#FDFBF7',
                        lavender: {
                            50: '#F6F4FF',
                            100: '#EDE9FE',
                            200: '#DDD6FE',
                            300: '#C4B5FD',
                            500: '#8B5CF6',
                            600: '#7C3AED',
                        },
                        sage: {
                            50: '#F2F8F5',
                            100: '#E0EFE8',
                            200: '#C2DFD1',
                            500: '#4D8B70',
                            600: '#3B7059',
                        },
                        peach: {
                            100: '#FFE8D6',
                            500: '#F59E0B',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #FDFBF7;
            background-image: radial-gradient(#DDD6FE 1px, transparent 1px), radial-gradient(#C2DFD1 1px, #FDFBF7 1px);
            background-size: 40px 40px;
            background-position: 0 0, 20px 20px;
            color: #2D2A3E;
            overflow-x: hidden;
        }

        /* Animasi Kartu & Efek Interaktif */
        @keyframes popIn {
            0% { transform: scale(0.92); opacity: 0; }
            70% { transform: scale(1.03); }
            100% { transform: scale(1); opacity: 1; }
        }

        @keyframes floatSlow {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }

        @keyframes pulseMatch {
            0% { box-shadow: 0 0 0 0 rgba(77, 139, 112, 0.5); }
            70% { box-shadow: 0 0 0 14px rgba(77, 139, 112, 0); }
            100% { box-shadow: 0 0 0 0 rgba(77, 139, 112, 0); }
        }

        @keyframes shakeSoft {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-6px); }
            50% { transform: translateX(6px); }
            75% { transform: translateX(-4px); }
        }

        .animate-pop {
            animation: popIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .animate-float {
            animation: floatSlow 4s ease-in-out infinite;
        }

        .match-success-anim {
            animation: pulseMatch 0.8s ease-out;
        }

        .shake-anim {
            animation: shakeSoft 0.4s ease-in-out;
        }

        /* Gaya Kartu Drag & Click */
        .game-card {
            transition: all 0.25s cubic-bezier(0.25, 0.8, 0.25, 1);
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        .game-card:hover:not(.matched-card) {
            transform: translateY(-3px);
            box-shadow: 0 12px 24px -8px rgba(124, 58, 237, 0.18);
        }

        .game-card.selected-card {
            border-color: #7C3AED;
            background-color: #F6F4FF;
            box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.25);
            transform: translateY(-3px);
        }

        .game-card.drag-over {
            border-color: #4D8B70;
            background-color: #F2F8F5;
            transform: scale(1.02);
            border-style: dashed;
        }

        .matched-card {
            background-color: #F2F8F5 !important;
            border-color: #4D8B70 !important;
            opacity: 0.92;
        }

        /* Custom Scrollbar lembut */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #FDFBF7;
        }
        ::-webkit-scrollbar-thumb {
            background: #C4B5FD;
            border-radius: 999px;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between antialiased selection:bg-lavender-200 selection:text-lavender-900">

    <!-- HEADER / NAVBAR (Selalu tampil rapi, skor muncul saat bermain) -->
    <header class="w-full sticky top-0 z-30 bg-cream/90 backdrop-blur-md border-b border-lavender-200/70 px-4 py-3">
        <div class="max-w-5xl mx-auto flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2.5 cursor-pointer" onclick="goHomeConfirm()">
                <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-lavender-500 to-lavender-600 flex items-center justify-center text-white shadow-md">
                    <!-- Ikon Kompas Karier SVG -->
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 2a10 10 0 100 20 10 10 0 000-20zm3.5 6.5l-2.2 5.3-5.3 2.2 2.2-5.3 5.3-2.2z"/>
                    </svg>
                </div>
                <div>
                    <span class="font-display font-extrabold text-base sm:text-lg text-slate-800 block leading-tight">Career Match</span>
                    <span class="text-xs font-medium text-lavender-600">Layanan BK • SMA Fase E</span>
                </div>
            </div>

            <!-- Panel Status Permainan (Tersembunyi di halaman pembuka) -->
            <div id="hud-bar" class="hidden flex items-center gap-2 sm:gap-4">
                <div class="bg-lavender-100/80 border border-lavender-200 px-3 py-1.5 rounded-2xl flex items-center gap-1.5">
                    <span class="text-xs font-semibold text-lavender-600 uppercase tracking-wider">Level</span>
                    <span id="hud-level" class="font-display font-extrabold text-sm sm:text-base text-slate-800">1/3</span>
                </div>
                <div class="bg-sage-100 border border-sage-200 px-3.5 py-1.5 rounded-2xl flex items-center gap-1.5 shadow-sm">
                    <span class="text-base">⭐</span>
                    <span class="text-xs font-semibold text-sage-600 hidden sm:inline">Skor:</span>
                    <span id="hud-score" class="font-display font-extrabold text-sm sm:text-base text-sage-600">0</span>
                </div>
                <button id="btn-sound" onclick="toggleSound()" title="Suara Efek" class="p-2 rounded-xl bg-white border border-lavender-200 text-slate-600 hover:bg-lavender-50 transition">
                    <span id="sound-icon">🔊</span>
                </button>
            </div>
        </div>
    </header>

    <!-- KONTEN UTAMA -->
    <main class="flex-grow w-full max-w-5xl mx-auto px-4 py-6 sm:py-10 flex flex-col justify-center">

        <!-- =========================================================
             HALAMAN 1: PEMBUKA (LANDING PAGE)
             ========================================================= -->
        <section id="page-intro" class="animate-pop">
            <div class="bg-white/95 rounded-3xl shadow-xl shadow-lavender-200/40 border border-lavender-200 p-6 sm:p-10 md:p-12 overflow-hidden relative">
                <!-- Dekorasi Latar -->
                <div class="absolute -top-16 -right-16 w-48 h-48 bg-lavender-100 rounded-full blur-2xl opacity-70 pointer-events-none"></div>
                <div class="absolute -bottom-16 -left-16 w-48 h-48 bg-sage-100 rounded-full blur-2xl opacity-70 pointer-events-none"></div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
                    <div class="lg:col-span-7 space-y-5 text-center lg:text-left">
                        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-lavender-100 text-lavender-600 font-semibold text-xs sm:text-sm">
                            <span>✨ Eksplorasi Karier & Potensi Diri</span>
                        </div>
                        <h1 class="font-display font-black text-3xl sm:text-4xl md:text-5xl text-slate-800 leading-tight">
                            Career Match <span class="text-lavender-600">Challenge</span>
                        </h1>
                        <p class="font-display font-bold text-lg sm:text-xl text-sage-600">
                            Temukan Kecocokan Potensi Dirimu dengan Pilihan Karier!
                        </p>
                        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
                            Pernah bingung memikirkan masa depan setelah lulus SMA? Melalui permainan interaktif ini, kamu akan diajak mengenali bagaimana <strong>minat, bakat, dan kemampuan</strong> saling terhubung dengan berbagai pilihan profesi—tanpa batasan kaku!
                        </p>

                        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3">
                            <button onclick="showPage('page-guide')" class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-lavender-500 to-lavender-600 hover:from-lavender-600 hover:to-lavender-700 text-white font-display font-extrabold text-base sm:text-lg shadow-lg shadow-lavender-500/30 transform hover:-translate-y-0.5 transition flex items-center justify-center gap-2">
                                <span>Mulai Bermain</span>
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
                            </button>
                            <button onclick="startGameDirectly()" class="w-full sm:w-auto px-6 py-4 rounded-2xl bg-sage-50 hover:bg-sage-100 text-sage-600 border border-sage-200 font-display font-bold text-sm sm:text-base transition">
                                Langsung ke Level 1
                            </button>
                        </div>
                    </div>

                    <!-- Ilustrasi SVG Profesi & Potensi -->
                    <div class="lg:col-span-5 flex justify-center">
                        <div class="w-full max-w-sm bg-gradient-to-br from-lavender-50 via-cream to-sage-50 rounded-3xl p-6 border border-lavender-200/80 shadow-inner animate-float">
                            <svg viewBox="0 0 320 260" class="w-full h-auto" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <!-- Lingkaran Utama -->
                                <circle cx="160" cy="130" r="95" fill="#EDE9FE"/>
                                <circle cx="160" cy="130" r="70" fill="#FDFBF7" stroke="#C4B5FD" stroke-width="2" stroke-dasharray="6 6"/>
                                
                                <!-- Ikon Tengah: Siswa & Bintang Potensi -->
                                <circle cx="160" cy="112" r="24" fill="#8B5CF6"/>
                                <path d="M124 174C124 154.118 140.118 138 160 138C179.882 138 196 154.118 196 174" fill="#7C3AED"/>
                                
                                <!-- Kartu Melayang 1: Seni / Kreatif -->
                                <rect x="24" y="34" width="76" height="54" rx="14" fill="#FFFFFF" stroke="#DDD6FE" stroke-width="2"/>
                                <text x="62" y="63" text-anchor="middle" font-size="22">🎨</text>
                                <text x="62" y="79" text-anchor="middle" font-size="9" font-weight="bold" fill="#6D28D9">Kreativitas</text>

                                <!-- Kartu Melayang 2: Sains / Alam -->
                                <rect x="220" y="34" width="76" height="54" rx="14" fill="#FFFFFF" stroke="#C2DFD1" stroke-width="2"/>
                                <text x="258" y="63" text-anchor="middle" font-size="22">🔬</text>
                                <text x="258" y="79" text-anchor="middle" font-size="9" font-weight="bold" fill="#3B7059">Observasi</text>

                                <!-- Kartu Melayang 3: Empati / Sosial -->
                                <rect x="24" y="172" width="76" height="54" rx="14" fill="#FFFFFF" stroke="#C2DFD1" stroke-width="2"/>
                                <text x="62" y="201" text-anchor="middle" font-size="22">🤝</text>
                                <text x="62" y="217" text-anchor="middle" font-size="9" font-weight="bold" fill="#3B7059">Empati</text>

                                <!-- Kartu Melayang 4: Logika / Analisis -->
                                <rect x="220" y="172" width="76" height="54" rx="14" fill="#FFFFFF" stroke="#DDD6FE" stroke-width="2"/>
                                <text x="258" y="201" text-anchor="middle" font-size="22">📊</text>
                                <text x="258" y="217" text-anchor="middle" font-size="9" font-weight="bold" fill="#6D28D9">Analisis</text>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- =========================================================
             HALAMAN 2: PETUNJUK BERMAIN
             ========================================================= -->
        <section id="page-guide" class="hidden animate-pop">
            <div class="bg-white/95 rounded-3xl shadow-xl shadow-lavender-200/40 border border-lavender-200 p-6 sm:p-10">
                <div class="text-center max-w-2xl mx-auto mb-8">
                    <span class="px-3.5 py-1 rounded-full bg-sage-100 text-sage-600 font-bold text-xs uppercase tracking-wider">Panduan Bermain</span>
                    <h2 class="font-display font-black text-2xl sm:text-3xl text-slate-800 mt-2">Bagaimana Cara Bermainnya?</h2>
                    <p class="text-slate-600 text-sm sm:text-base mt-2">
                        Ikuti 3 tahapan seru berikut untuk melatih pemahamanmu tentang hubungan potensi diri dan dunia kerja.
                    </p>
                </div>

                <!-- 3 Tahapan Level -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
                    <div class="bg-lavender-50/80 border border-lavender-200 rounded-2xl p-5 flex flex-col justify-between">
                        <div>
                            <div class="w-11 h-11 rounded-2xl bg-lavender-500 text-white font-display font-black text-lg flex items-center justify-center mb-4 shadow-sm">1</div>
                            <h3 class="font-display font-extrabold text-lg text-slate-800 mb-2">Level 1: Kenali Potensimu</h3>
                            <p class="text-sm text-slate-600 leading-relaxed">
                                Baca 5 kartu profil teman sebaya dengan teliti. Pahami kombinasi <strong>minat</strong> (hal yang disukai), <strong>bakat</strong> (potensi alami), dan <strong>kemampuan</strong> mereka.
                            </p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-lavender-200/60 text-xs font-semibold text-lavender-600">
                            🔍 Tandai kartu yang sudah dipahami
                        </div>
                    </div>

                    <div class="bg-sage-50/80 border border-sage-200 rounded-2xl p-5 flex flex-col justify-between">
                        <div>
                            <div class="w-11 h-11 rounded-2xl bg-sage-500 text-white font-display font-black text-lg flex items-center justify-center mb-4 shadow-sm">2</div>
                            <h3 class="font-display font-extrabold text-lg text-slate-800 mb-2">Level 2: Career Matching</h3>
                            <p class="text-sm text-slate-600 leading-relaxed">
                                Pasangkan kartu profil dengan pilihan profesi yang relevan! Kamu bisa <strong>klik kartu profil lalu klik profesinya</strong>, atau <strong>tarik & lepas (drag-and-drop)</strong>.
                            </p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-sage-200/60 text-xs font-semibold text-sage-600">
                            💡 Ingat: 1 profil bisa cocok dengan beberapa profesi!
                        </div>
                    </div>

                    <div class="bg-amber-50/70 border border-amber-200 rounded-2xl p-5 flex flex-col justify-between">
                        <div>
                            <div class="w-11 h-11 rounded-2xl bg-amber-500 text-white font-display font-black text-lg flex items-center justify-center mb-4 shadow-sm">3</div>
                            <h3 class="font-display font-extrabold text-lg text-slate-800 mb-2">Level 3: Career Challenge</h3>
                            <p class="text-sm text-slate-600 leading-relaxed">
                                Hadapi studi kasus nyata siswa SMA! Pilih karier yang paling relevan beserta <strong>alasan logis</strong> yang menghubungkan potensi dengan tugas profesi tersebut.
                            </p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-amber-200/60 text-xs font-semibold text-amber-700">
                            🏆 Dapatkan poin bonus di setiap kasus!
                        </div>
                    </div>
                </div>

                <!-- Catatan Penting BK -->
                <div class="bg-lavender-100/60 border border-lavender-200 rounded-2xl p-4 sm:p-5 mb-8 flex items-start gap-3.5">
                    <span class="text-2xl">🌱</span>
                    <div class="text-xs sm:text-sm text-slate-700 leading-relaxed">
                        <strong class="text-lavender-700 block mb-0.5">Catatan Bimbingan & Konseling:</strong>
                        Tidak ada satu profesi tunggal yang mutlak untuk satu tipe orang. Seseorang yang empatik bisa menjadi Konselor, Dokter, Guru, maupun Perawat. Game ini melatih cara berpikir terbuka dalam mengeksplorasi karier!
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                    <button onclick="showPage('page-intro')" class="w-full sm:w-auto px-6 py-3 rounded-2xl bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 font-bold text-sm transition">
                        ← Kembali
                    </button>
                    <button onclick="startGameDirectly()" class="w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-gradient-to-r from-lavender-500 to-lavender-600 hover:from-lavender-600 hover:to-lavender-700 text-white font-display font-extrabold text-base shadow-lg shadow-lavender-500/25 transition">
                        Mulai Level 1 Sekarang 🚀
                    </button>
                </div>
            </div>
        </section>

        <!-- =========================================================
             HALAMAN 3: PERMAINAN (LEVEL 1, LEVEL 2, LEVEL 3)
             ========================================================= -->
        <section id="page-game" class="hidden space-y-6">
            
            <!-- Stepper Progress Level -->
            <div class="bg-white/90 rounded-2xl border border-lavender-200 p-4 shadow-sm">
                <div class="flex items-center justify-between text-xs sm:text-sm font-bold mb-2">
                    <span id="step-label-1" class="text-lavender-600">1. Kenali Potensi</span>
                    <span id="step-label-2" class="text-slate-400">2. Career Matching</span>
                    <span id="step-label-3" class="text-slate-400">3. Career Challenge</span>
                </div>
                <div class="w-full h-2.5 bg-lavender-100 rounded-full overflow-hidden">
                    <div id="progress-bar-fill" class="h-full bg-gradient-to-r from-lavender-500 to-sage-500 rounded-full transition-all duration-500" style="width: 33%"></div>
                </div>
            </div>

            <!-- KONTEN LEVEL 1: KENALI POTENSIMU -->
            <div id="level-1-view" class="hidden animate-pop space-y-6">
                <div class="bg-white/95 rounded-3xl border border-lavender-200 p-6 sm:p-8 shadow-md">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-lavender-100 pb-5 mb-6">
                        <div>
                            <span class="px-3 py-1 rounded-full bg-lavender-100 text-lavender-600 font-bold text-xs">LEVEL 1 • EKSPLORASI PROFIL</span>
                            <h2 class="font-display font-black text-xl sm:text-2xl text-slate-800 mt-1.5">Kenali Potensi 5 Karakter Berikut</h2>
                            <p class="text-slate-600 text-xs sm:text-sm mt-1">
                                Klik setiap kartu profil untuk membaca detail <strong>Minat, Bakat, dan Kemampuan</strong> mereka sebelum mencocokkan kariernya di Level 2!
                            </p>
                        </div>
                        <div class="bg-sage-50 border border-sage-200 px-4 py-2.5 rounded-2xl text-center shrink-0">
                            <span class="text-xs text-sage-600 font-semibold block">Profil Dipelajari</span>
                            <span id="l1-counter" class="font-display font-black text-lg text-sage-600">0 / 5</span>
                        </div>
                    </div>

                    <!-- Grid Kartu Profil Level 1 -->
                    <div id="l1-cards-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        <!-- Diisi secara dinamis oleh JS -->
                    </div>

                    <div class="mt-8 pt-5 border-t border-lavender-100 flex flex-col sm:flex-row items-center justify-between gap-4">
                        <p id="l1-hint" class="text-xs sm:text-sm text-slate-500 italic">
                            💡 Klik semua kartu di atas untuk membuka tombol lanjut ke Level 2 (+50 Poin).
                        </p>
                        <button id="btn-to-level-2" disabled onclick="initLevel2()" class="w-full sm:w-auto px-7 py-3.5 rounded-2xl bg-slate-200 text-slate-400 font-display font-extrabold text-sm sm:text-base transition cursor-not-allowed">
                            Lanjut ke Level 2: Career Matching →
                        </button>
                    </div>
                </div>
            </div>

            <!-- KONTEN LEVEL 2: CAREER MATCHING -->
            <div id="level-2-view" class="hidden animate-pop space-y-6">
                <div class="bg-white/95 rounded-3xl border border-lavender-200 p-5 sm:p-8 shadow-md">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-lavender-100 pb-5 mb-6">
                        <div>
                            <span class="px-3 py-1 rounded-full bg-sage-100 text-sage-600 font-bold text-xs">LEVEL 2 • MATCHING GAME</span>
                            <h2 class="font-display font-black text-xl sm:text-2xl text-slate-800 mt-1.5">Pasangkan Potensi dengan Profesi Relevan</h2>
                            <p class="text-slate-600 text-xs sm:text-sm mt-1">
                                <strong>Cara bermain:</strong> Klik satu <em>Kartu Profil</em> di kolom kiri, lalu klik <em>Kartu Profesi</em> yang cocok di kolom kanan (atau geser/drag kartu profil ke kartu profesi).
                            </p>
                        </div>
                        <div class="bg-lavender-50 border border-lavender-200 px-4 py-2.5 rounded-2xl text-center shrink-0">
                            <span class="text-xs text-lavender-600 font-semibold block">Pasangan Selesai</span>
                            <span id="l2-counter" class="font-display font-black text-lg text-lavender-600">0 / 5</span>
                        </div>
                    </div>

                    <!-- Area Matching 2 Kolom -->
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                        <!-- Kolom Kiri: Kartu Profil (5 Profil) -->
                        <div class="lg:col-span-5 space-y-3">
                            <h3 class="font-display font-extrabold text-sm uppercase tracking-wider text-lavender-600 flex items-center gap-2">
                                <span>👤 Kartu Profil Individu</span>
                            </h3>
                            <div id="l2-profiles-list" class="space-y-3">
                                <!-- Kartu Profil Level 2 -->
                            </div>
                        </div>

                        <!-- Kolom Kanan: Kartu Pilihan Pekerjaan (8 Pilihan Beragam) -->
                        <div class="lg:col-span-7 space-y-3">
                            <div class="flex items-center justify-between">
                                <h3 class="font-display font-extrabold text-sm uppercase tracking-wider text-sage-600 flex items-center gap-2">
                                    <span>💼 Pilihan Profesi (Tersedia 8 Profesi)</span>
                                </h3>
                                <span class="text-xs text-slate-500 hidden sm:inline">Beberapa profesi bisa cocok untuk 1 profil!</span>
                            </div>
                            <div id="l2-careers-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <!-- Kartu Profesi Level 2 -->
                            </div>
