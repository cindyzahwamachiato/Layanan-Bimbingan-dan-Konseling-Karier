                title: 'Kasus 3: Pilihan Karier Fajar yang Menyukai Angka & Diskusi',
                story: 'Fajar sangat menyukai matematika dan senang menghitung rincian anggaran kegiatan OSIS. Di sisi lain, ia juga senang berdiskusi dan menjelaskan konsep hitungan yang rumit dengan bahasa sederhana kepada teman-temannya.',
                question: 'Pilihan karier mana yang paling mencerminkan fleksibilitas potensi Fajar?',
                options: [
                    {
                        id: 'opt1',
                        text: 'Guru Matematika, Akuntan, atau Konsultan Keuangan — karena kemampuan analisis angka dapat dipadukan dengan keterampilan komunikasi.',
                        correct: true,
                        feedback: 'Sempurna! Kamu memahami bahwa satu kombinasi potensi (logika angka + komunikasi) bisa relevan dengan berbagai profesi, baik di bidang pendidikan maupun keuangan.'
                    },
                    {
                        id: 'opt2',
                        text: 'Jurnalis Olahraga — karena semua anggota OSIS pasti berbakat meliput pertandingan.',
                        correct: false,
                        feedback: 'Kurang tepat. Aktif di OSIS melatih organisasi, tetapi potensi spesifik Fajar yang menonjol adalah analisis angka dan menjelaskan konsep logis.'
                    },
                    {
                        id: 'opt3',
                        text: 'Ilustrator Komik — karena menghitung anggaran sama dengan menggambar karakter cerita.',
                        correct: false,
                        feedback: 'Belum sesuai. Ilustrator lebih berfokus pada bakat menggambar dan imajinasi visual, sedangkan kekuatan Fajar adalah logika numerik dan komunikasi.'
                    }
                ]
            }
        ];

        // --- 2. STATE PERMAINAN ---
        let gameState = {
            score: 0,
            level: 1,
            l1ViewedIds: new Set(),
            l2SelectedProfileId: null,
            l2MatchedPairs: {}, // { profileId: careerId }
            l3CurrentIndex: 0,
            l3AttemptsCurrent: 0,
            soundEnabled: true,
            modalCallback: null
        };

        // --- 3. SISTEM AUDIO LEMBUT (TONE.JS) ---
        let synth = null;
        function playTone(type) {
            if (!gameState.soundEnabled) return;
            try {
                if (!synth) {
                    synth = new Tone.PolySynth(Tone.Synth).toDestination();
                    synth.volume.value = -10;
                }
                if (Tone.context.state !== 'running') {
                    Tone.start();
                }
                const now = Tone.now();
                if (type === 'click') {
                    synth.triggerAttackRelease('C5', '32n', now);
                } else if (type === 'match') {
                    synth.triggerAttackRelease(['C5', 'E5', 'G5'], '16n', now);
                } else if (type === 'retry') {
                    synth.triggerAttackRelease(['E4', 'D4'], '16n', now);
                } else if (type === 'win') {
                    synth.triggerAttackRelease(['C5', 'E5', 'G5', 'C6'], '8n', now);
                }
            } catch (e) {
                // Abaikan jika browser memblokir audio
            }
        }

        function toggleSound() {
            gameState.soundEnabled = !gameState.soundEnabled;
            document.getElementById('sound-icon').textContent = gameState.soundEnabled ? '🔊' : '🔇';
            showToast(gameState.soundEnabled ? 'Efek suara aktif' : 'Efek suara dimatikan');
        }

        // --- 4. NAVIGASI HALAMAN & HUD ---
        function showPage(pageId) {
            playTone('click');
            const pages = ['page-intro', 'page-guide', 'page-game', 'page-result', 'page-reflection'];
            pages.forEach(id => {
                document.getElementById(id).classList.add('hidden');
            });
            document.getElementById(pageId).classList.remove('hidden');

            const hud = document.getElementById('hud-bar');
            if (pageId === 'page-game') {
                hud.classList.remove('hidden');
            } else {
                hud.classList.add('hidden');
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function updateHUD() {
            document.getElementById('hud-level').textContent = `${gameState.level}/3`;
            document.getElementById('hud-score').textContent = gameState.score;

            // Update Progress Bar & Stepper
            const progressFill = document.getElementById('progress-bar-fill');
            const s1 = document.getElementById('step-label-1');
            const s2 = document.getElementById('step-label-2');
            const s3 = document.getElementById('step-label-3');

            [s1, s2, s3].forEach(el => el.className = 'text-slate-400');

            if (gameState.level === 1) {
                progressFill.style.width = '33%';
                s1.className = 'text-lavender-600 font-extrabold';
            } else if (gameState.level === 2) {
                progressFill.style.width = '66%';
                s1.className = 'text-sage-600';
                s2.className = 'text-lavender-600 font-extrabold';
            } else {
                progressFill.style.width = '100%';
                s1.className = 'text-sage-600';
                s2.className = 'text-sage-600';
                s3.className = 'text-lavender-600 font-extrabold';
            }
        }

        function addScore(points) {
            gameState.score += points;
            updateHUD();
        }

        function goHomeConfirm() {
            if (document.getElementById('page-game').classList.contains('hidden')) {
                showPage('page-intro');
            } else {
                showToast('Gunakan tombol "Main Lagi" di akhir permainan atau selesaikan level ini ya!');
            }
        }

        function startGameDirectly() {
            resetGameState();
            showPage('page-game');
            initLevel1();
        }

        function resetGameState() {
            gameState.score = 0;
            gameState.level = 1;
            gameState.l1ViewedIds.clear();
            gameState.l2SelectedProfileId = null;
            gameState.l2MatchedPairs = {};
            gameState.l3CurrentIndex = 0;
            gameState.l3AttemptsCurrent = 0;
            updateHUD();
        }

        function resetAndPlayAgain() {
            resetGameState();
            document.getElementById('reflection-saved-card').classList.add('hidden');
            showPage('page-game');
            initLevel1();
        }

        // --- 5. LOGIKA LEVEL 1: KENALI POTENSIMU ---
        function initLevel1() {
            gameState.level = 1;
            updateHUD();
            document.getElementById('level-1-view').classList.remove('hidden');
            document.getElementById('level-2-view').classList.add('hidden');
            document.getElementById('level-3-view').classList.add('hidden');

            const container = document.getElementById('l1-cards-container');
            container.innerHTML = '';

            PROFILES_DATA.forEach(profile => {
                const isViewed = gameState.l1ViewedIds.has(profile.id);
                const card = document.createElement('div');
                card.id = `l1-card-${profile.id}`;
                card.className = `game-card cursor-pointer rounded-2xl border-2 p-5 transition ${
                    isViewed ? 'bg-sage-50/70 border-sage-400' : 'bg-cream/80 border-lavender-200 hover:border-lavender-400'
                }`;
                card.onclick = () => inspectProfileL1(profile);

                card.innerHTML = `
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-3">
                            <span class="w-11 h-11 rounded-2xl bg-white border border-lavender-200 flex items-center justify-center text-2xl shadow-sm">${profile.avatar}</span>
                            <div>
                                <h3 class="font-display font-extrabold text-base text-slate-800">${profile.name}</h3>
                                <span class="text-xs font-semibold text-lavender-600">${profile.shortTag}</span>
                            </div>
                        </div>
                        <span id="l1-badge-${profile.id}" class="text-xs font-bold px-2.5 py-1 rounded-full ${isViewed ? 'bg-sage-500 text-white' : 'bg-lavender-100 text-lavender-600'}">
                            ${isViewed ? '✓ Dipahami' : 'Klik Baca'}
                        </span>
                    </div>
                    <div class="space-y-2 text-xs text-slate-600 bg-white/90 p-3.5 rounded-xl border border-lavender-100">
                        <p><strong class="text-lavender-700">💖 Minat:</strong> ${profile.minat}</p>
                        <p><strong class="text-sage-600">✨ Bakat:</strong> ${profile.bakat}</p>
                        <p><strong class="text-amber-600">🛠️ Kemampuan:</strong> ${profile.kemampuan}</p>
                    </div>
                `;
                container.appendChild(card);
            });
            updateL1Progress();
        }

        function inspectProfileL1(profile) {
            if (!gameState.l1ViewedIds.has(profile.id)) {
                gameState.l1ViewedIds.add(profile.id);
                addScore(10); // +10 poin setiap mempelajari profil
                playTone('match');

                const card = document.getElementById(`l1-card-${profile.id}`);
                const badge = document.getElementById(`l1-badge-${profile.id}`);
                card.classList.remove('bg-cream/80', 'border-lavender-200');
                card.classList.add('bg-sage-50/70', 'border-sage-400', 'match-success-anim');
                badge.className = 'text-xs font-bold px-2.5 py-1 rounded-full bg-sage-500 text-white';
                badge.textContent = '✓ Dipahami';

                updateL1Progress();
            } else {
                playTone('click');
                showToast(`Kamu sudah mempelajari profil ${profile.name} (+10 poin)`);
            }
        }

        function updateL1Progress() {
            const count = gameState.l1ViewedIds.size;
            document.getElementById('l1-counter').textContent = `${count} / ${PROFILES_DATA.length}`;

            const btn = document.getElementById('btn-to-level-2');
            const hint = document.getElementById('l1-hint');

            if (count === PROFILES_DATA.length) {
                btn.disabled = false;
                btn.className = 'w-full sm:w-auto px-7 py-3.5 rounded-2xl bg-gradient-to-r from-lavender-500 to-lavender-600 hover:from-lavender-600 hover:to-lavender-700 text-white font-display font-extrabold text-sm sm:text-base shadow-lg shadow-lavender-500/25 transition cursor-pointer';
                hint.textContent = '🎉 Keren! Semua potensi karakter sudah kamu pahami. Ayo lanjut ke Level 2!';
                hint.className = 'text-xs sm:text-sm text-sage-600 font-bold';
            }
        }

        // --- 6. LOGIKA LEVEL 2: CAREER MATCHING (KLIK & DRAG-DROP) ---
        function initLevel2() {
            playTone('click');
            gameState.level = 2;
            updateHUD();
            document.getElementById('level-1-view').classList.add('hidden');
            document.getElementById('level-2-view').classList.remove('hidden');
            document.getElementById('level-3-view').classList.add('hidden');

            renderLevel2Board();
        }

        function renderLevel2Board() {
            const profilesList = document.getElementById('l2-profiles-list');
            const careersGrid = document.getElementById('l2-careers-grid');
            profilesList.innerHTML = '';
            careersGrid.innerHTML = '';

            const matchedCount = Object.keys(gameState.l2MatchedPairs).length;
            document.getElementById('l2-counter').textContent = `${matchedCount} / ${PROFILES_DATA.length}`;

            // Render Kartu Profil (Kiri)
            PROFILES_DATA.forEach(profile => {
                const matchedCareerId = gameState.l2MatchedPairs[profile.id];
                const isSelected = gameState.l2SelectedProfileId === profile.id;
                const matchedCareerObj = CAREERS_DATA.find(c => c.id === matchedCareerId);

                const pCard = document.createElement('div');
                pCard.id = `l2-prof-${profile.id}`;
                pCard.draggable = !matchedCareerId;
                pCard.className = `game-card rounded-2xl border-2 p-4 relative ${
                    matchedCareerId
                        ? 'matched-card cursor-default'
                        : isSelected
                        ? 'selected-card cursor-pointer'
                        : 'bg-white border-lavender-200 cursor-pointer'
                }`;

                // Event Klik
                if (!matchedCareerId) {
                    pCard.onclick = () => selectProfileL2(profile.id);
                    // Event Drag Start
                    pCard.ondragstart = (e) => {
                        gameState.l2SelectedProfileId = profile.id;
                        e.dataTransfer.setData('text/plain', profile.id);
                        pCard.classList.add('opacity-60');
                    };
                    pCard.ondragend = () => {
                        pCard.classList.remove('opacity-60');
                    };
                }

                pCard.innerHTML = `
                    <div class="flex items-start justify-between gap-2">
                        <div class="flex items-center gap-2.5">
                            <span class="text-2xl">${profile.avatar}</span>
                            <div>
                                <h4 class="font-display font-extrabold text-sm text-slate-800">${profile.name}</h4>
                                <p class="text-xs text-slate-600 line-clamp-2 mt-0.5">${profile.minat}</p>
                            </div>
                        </div>
                        ${
                            matchedCareerId
                                ? `<span class="shrink-0 px-2.5 py-1 rounded-xl bg-sage-500 text-white text-[11px] font-bold">✓ ${matchedCareerObj.title}</span>`
                                : `<span class="shrink-0 px-2 py-0.5 rounded-lg bg-lavender-100 text-lavender-600 text-[11px] font-bold">${isSelected ? 'Terpilih' : 'Pilih'}</span>`
                        }
                    </div>
                    <div class="mt-2.5 pt-2 border-t border-slate-100 flex flex-wrap gap-1.5 text-[11px]">
                        <span class="px-2 py-0.5 rounded-md bg-lavender-50 text-lavender-700 font-medium">✨ ${profile.shortTag}</span>
                    </div>
                `;
                profilesList.appendChild(pCard);
            });

            // Render Kartu Profesi (Kanan)
            CAREERS_DATA.forEach(career => {
                // Cek apakah profesi ini sudah dipakai oleh salah satu profil
                const usedByProfileId = Object.keys(gameState.l2MatchedPairs).find(
                    pId => gameState.l2MatchedPairs[pId] === career.id
                );
                const usedByProfile = PROFILES_DATA.find(p => p.id === usedByProfileId);

                const cCard = document.createElement('div');
                cCard.id = `l2-car-${career.id}`;
                cCard.className = `game-card rounded-2xl border-2 p-4 flex flex-col justify-between ${
                    usedByProfile
                        ? 'matched-card cursor-default'
                        : 'bg-cream/90 border-sage-200 hover:border-sage-500 cursor-pointer'
                }`;

                if (!usedByProfile) {
                    cCard.onclick = () => attemptMatchL2(career.id);

                    // Event Drag Over & Drop
                    cCard.ondragover = (e) => {
                        e.preventDefault();
                        cCard.classList.add('drag-over');
                    };
                    cCard.ondragleave = () => {
                        cCard.classList.remove('drag-over');
                    };
                    cCard.ondrop = (e) => {
                        e.preventDefault();
                        cCard.classList.remove('drag-over');
                        const draggedProfileId = e.dataTransfer.getData('text/plain') || gameState.l2SelectedProfileId;
                        if (draggedProfileId) {
                            gameState.l2SelectedProfileId = draggedProfileId;
                            attemptMatchL2(career.id);
                        }
                    };
                }

                cCard.innerHTML = `
                    <div class="flex items-start gap-3">
                        <span class="w-10 h-10 rounded-xl bg-white border border-sage-200 flex items-center justify-center text-xl shrink-0 shadow-sm">${career.icon}</span>
                        <div>
                            <h4 class="font-display font-extrabold text-sm text-slate-800">${career.title}</h4>
                            <p class="text-xs text-slate-600 mt-1 leading-relaxed">${career.desc}</p>
                        </div>
                    </div>
                    ${
                        usedByProfile
                            ? `<div class="mt-3 pt-2 border-t border-sage-200 text-[11px] font-bold text-sage-600">✅ Dipasangkan dengan ${usedByProfile.name.split(' ')[0]}</div>`
                            : `<div class="mt-3 pt-2 border-t border-sage-100 text-[11px] font-semibold text-sage-600/80 text-right">Klik atau lepas kartu di sini</div>`
                    }
                `;
                careersGrid.appendChild(cCard);
            });

            // Cek jika semua 5 profil sudah terpasang
            if (matchedCount === PROFILES_DATA.length) {
                document.getElementById('l2-complete-bar').classList.remove('hidden');
            }
        }

        function selectProfileL2(profileId) {
            playTone('click');
            if (gameState.l2SelectedProfileId === profileId) {
                gameState.l2SelectedProfileId = null;
            } else {
                gameState.l2SelectedProfileId = profileId;
            }
            renderLevel2Board();
        }

        function attemptMatchL2(careerId) {
            const selectedId = gameState.l2SelectedProfileId;
            if (!selectedId) {
                playTone('retry');
                showToast('Pilih atau klik salah satu Kartu Profil di sebelah kiri terlebih dahulu ya!');
                return;
            }

            const profile = PROFILES_DATA.find(p => p.id === selectedId);
            const career = CAREERS_DATA.find(c => c.id === careerId);

            if (profile.validCareers.includes(careerId)) {
                // KECOCOKAN RELEVAN!
                playTone('match');
                gameState.l2MatchedPairs[profile.id] = careerId;
                gameState.l2SelectedProfileId = null;
                addScore(30); // +30 poin per pasangan tepat

                renderLevel2Board();

                openFeedbackModal({
                    isSuccess: true,
                    tag: 'Pasangan Sangat Relevan! (+30 Poin)',
                    title: `${profile.name.split(' ')[0]} ↔ ${career.title}`,
                    body: profile.matchExplanations[careerId],
                    alternatives: profile.alternativeNote
                });
            } else {
                // KURANG SESUAI -> BERIKAN PETUNJUK EDUKATIF & KESEMPATAN COBA LAGI
                playTone('retry');
                const cardEl = document.getElementById(`l2-car-${careerId}`);
                if (cardEl) cardEl.classList.add('shake-anim');

                openFeedbackModal({
                    isSuccess: false,
                    tag: 'Mari Kita Tinjau Kembali 🔍',
                    title: `Hubungan ${profile.name.split(' ')[0]} & ${career.title}`,
                    body: `Profesi <strong>${career.title}</strong> berfokus pada: <em>"${career.desc}"</em>.<br><br>Sementara itu, kekuatan utama <strong>${profile.name.split(' ')[0]}</strong> ada pada <strong>${profile.shortTag}</strong> (${profile.minat.toLowerCase()}). Coba cari profesi lain yang lebih selaras dengan minat dan bakat tersebut!`,
                    alternatives: null
                });
            }
        }

        // --- 7. LOGIKA LEVEL 3: CAREER CHALLENGE (KASUS & ALASAN) ---
        function initLevel3() {
            playTone('click');
            gameState.level = 3;
            gameState.l3CurrentIndex = 0;
            gameState.l3AttemptsCurrent = 0;
            updateHUD();

            document.getElementById('level-1-view').classList.add('hidden');
            document.getElementById('level-2-view').classList.add('hidden');
            document.getElementById('level-3-view').classList.remove('hidden');

            renderLevel3Case();
        }

        function renderLevel3Case() {
            const idx = gameState.l3CurrentIndex;
            const currentCase = LEVEL3_CASES[idx];
            document.getElementById('l3-counter').textContent = `${idx + 1} / ${LEVEL3_CASES.length}`;

            const box = document.getElementById('l3-case-box');
            box.innerHTML = `
                <div class="bg-gradient-to-br from-lavender-50 to-cream border border-lavender-200 rounded-2xl p-5 sm:p-6">
                    <h3 class="font-display font-extrabold text-lg text-lavender-700 mb-2">${currentCase.title}</h3>
                    <p class="text-sm sm:text-base text-slate-700 leading-relaxed">${currentCase.story}</p>
                </div>

                <div>
                    <h4 class="font-display font-extrabold text-sm sm:text-base text-slate-800 mb-3">
                        🤔 ${currentCase.question}
                    </h4>
                    <div class="space-y-3">
                        ${currentCase.options.map((opt, i) => `
                            <button onclick="evaluateLevel3Option('${opt.id}')" class="w-full text-left p-4 sm:p-5 rounded-2xl bg-white hover:bg-lavender-50/70 border-2 border-lavender-200 hover:border-lavender-500 transition flex items-start gap-3.5 group">
                                <span class="w-8 h-8 rounded-xl bg-lavender-100 group-hover:bg-lavender-500 group-hover:text-white text-lavender-700 font-display font-extrabold text-sm flex items-center justify-center shrink-0 transition">
                                    ${String.fromCharCode(65 + i)}
                                </span>
                                <span class="text-xs sm:text-sm text-slate-700 font-medium leading-relaxed pt-1">${opt.text}</span>
                            </button>
                        `).join('')}
                    </div>
                </div>
            `;
        }

        function evaluateLevel3Option(optionId) {
            const currentCase = LEVEL3_CASES[gameState.l3CurrentIndex];
            const chosen = currentCase.options.find(o => o.id === optionId);

            if (chosen.correct) {
                playTone('match');
                // Bonus poin jika langsung tepat pada percobaan pertama!
                const isFirstTry = gameState.l3AttemptsCurrent === 0;
                const earned = isFirstTry ? 50 : 30;
                addScore(earned);

                const isLastCase = gameState.l3CurrentIndex === LEVEL3_CASES.length - 1;

                openFeedbackModal({
                    isSuccess: true,
                    tag: isFirstTry ? `Tepat Sekali! (+${earned} Poin Bonus!)` : `Analisis Tepat! (+${earned} Poin)`,
                    title: 'Penalaran Karier yang Matang!',
                    body: chosen.feedback,
                    alternatives: null,
                    onClose: () => {
                        if (isLastCase) {
                            finishGame();
                        } else {
                            gameState.l3CurrentIndex++;
                            gameState.l3AttemptsCurrent = 0;
                            renderLevel3Case();
                        }
                    }
                });
            } else {
                playTone('retry');
                gameState.l3AttemptsCurrent++;
                openFeedbackModal({
                    isSuccess: false,
                    tag: 'Coba Analisis Lagi 💡',
                    title: 'Belum Paling Relevan',
                    body: chosen.feedback + '<br><br>Silakan baca kembali minat dan kemampuan tokoh pada studi kasus, lalu pilih alasan yang paling menghubungkan keduanya!',
                    alternatives: null
                });
            }
        }

        // --- 8. HALAMAN HASIL & REFLEKSI ---
        function finishGame() {
            playTone('win');
            showPage('page-result');
            document.getElementById('final-score-display').textContent = gameState.score;

            const titleEl = document.getElementById('result-badge-title');
            if (gameState.score >= 320) {
                titleEl.textContent = 'Master Eksplorasi Karier! 🌟';
            } else if (gameState.score >= 250) {
                titleEl.textContent = 'Perencana Karier Cerdas! 🚀';
            } else {
                titleEl.textContent = 'Penjelajah Potensi Hebat! 🌱';
            }
        }

        function saveReflection() {
            playTone('match');
            const q1 = document.getElementById('ref-q1').value.trim();
            const q2 = document.getElementById('ref-q2').value.trim();
            const q3 = document.getElementById('ref-q3').value.trim();

            if (!q1 && !q2 && !q3) {
                showToast('Tuliskan minimal satu jawaban refleksimu terlebih dahulu ya!');
                return;
            }

            const summary = `✨ REFLEKSI KARIERKU (SMA FASE E)\n` +
                `• Potensi yang paling kukenali: ${q1 || '-'}\n` +
                `• Karier yang ingin dieksplorasi: ${q2 || '-'}\n` +
                `• Langkah kecilku di kelas X: ${q3 || '-'}`;

            document.getElementById('reflection-preview-text').textContent = summary;
            document.getElementById('reflection-saved-card').classList.remove('hidden');
            showToast('Refleksi berhasil dirangkum!');
        }

        function copyReflection() {
            const text = document.getElementById('reflection-preview-text').textContent;
            const tempInput = document.createElement('textarea');
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);
            showToast('Teks refleksi berhasil disalin ke clipboard! 📋');
        }

        // --- 9. KONTROL MODAL UMPAN BALIK & TOAST ---
        function openFeedbackModal({ isSuccess, tag, title, body, alternatives, onClose }) {
            const modal = document.getElementById('feedback-modal');
            const iconBox = document.getElementById('modal-icon-box');
            const tagEl = document.getElementById('modal-tag');
            const titleEl = document.getElementById('modal-title');
            const bodyEl = document.getElementById('modal-body');
            const altBox = document.getElementById('modal-alternatives');
            const altText = document.getElementById('modal-alt-text');
            const closeBtn = document.getElementById('modal-close-btn');

            if (isSuccess) {
                iconBox.className = 'w-12 h-12 rounded-2xl bg-sage-100 text-2xl flex items-center justify-center shrink-0';
                iconBox.textContent = '🌟';
                tagEl.className = 'text-xs font-extrabold uppercase tracking-wider text-sage-600';
                closeBtn.className = 'w-full sm:w-auto px-7 py-3 rounded-2xl bg-sage-600 hover:bg-sage-700 text-white font-display font-extrabold text-sm transition';
                closeBtn.textContent = 'Lanjutkan';
            } else {
                iconBox.className = 'w-12 h-12 rounded-2xl bg-amber-100 text-2xl flex items-center justify-center shrink-0';
                iconBox.textContent = '🧭';
                tagEl.className = 'text-xs font-extrabold uppercase tracking-wider text-amber-600';
                closeBtn.className = 'w-full sm:w-auto px-7 py-3 rounded-2xl bg-lavender-600 hover:bg-lavender-700 text-white font-display font-extrabold text-sm transition';
                closeBtn.textContent = 'Coba Kembali';
            }

            tagEl.textContent = tag;
            titleEl.textContent = title;
            bodyEl.innerHTML = body;

            if (alternatives) {
                altBox.classList.remove('hidden');
                altText.textContent = alternatives;
            } else {
                altBox.classList.add('hidden');
            }

            gameState.modalCallback = onClose || null;
            modal.classList.remove('hidden');
        }

        function closeFeedbackModal() {
            playTone('click');
            document.getElementById('feedback-modal').classList.add('hidden');
            if (typeof gameState.modalCallback === 'function') {
                const cb = gameState.modalCallback;
                gameState.modalCallback = null;
                cb();
            }
        }

        let toastTimer = null;
        function showToast(message) {
            const toast = document.getElementById('toast-box');
            document.getElementById('toast-msg').textContent = message;
            toast.classList.remove('hidden');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                toast.classList.add('hidden');
            }, 3000);
        }
    </script>
</body>
</html>
